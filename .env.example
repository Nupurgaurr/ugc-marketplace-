# Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored. Never commit real keys.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
# Safe in the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role
# Bypasses RLS. Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

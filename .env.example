# Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored. Never commit real keys.

# Project Settings -> API -> Project URL
# The base URL only, e.g. https://yourref.supabase.co
# Not the /rest/v1/ endpoint: supabase-js appends its own paths, and pasting
# the REST URL here makes every request 404.
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> Project API keys -> anon public
# Safe in the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login (separate from Supabase Auth — see lib/admin/session.ts) ---

# Any long random string. Signs the admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# scrypt hashes, not passwords. Generate with:
# npm run admin:hash-password -- "the-password"
# Output is `salt:hash` — paste it verbatim.
ADMIN_DHRUV_PASSWORD_HASH=
ADMIN_NUPUR_PASSWORD_HASH=
